{
    "manifest_version": 3,
    "name": "Privacy Risk Scanner",
    "version": "3.1",
    "description": "AI Powered Privacy Risk Scanner",
    "permissions": [
        "activeTab",
        "tabs",
        "storage"
    ],
    "host_permissions": [
        "<all_urls>",
        "http://127.0.0.1:5000/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "*.otf"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}